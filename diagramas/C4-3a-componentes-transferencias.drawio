<mxCell id="e33" value="Consulta riesgo y listas" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e34" value="Nivel de autenticacion exigido&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[gRPC · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e35" value="Criba al beneficiario&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[REST · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e36" value="Persiste estado y evento" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e37" value="Escribe y lee&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[JDBC · TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e38" value="Bandeja pendiente" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e39" value="Enruta la ejecucion" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e40" value="Delega en el esquema" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e41" value="Reserva y liquida fondos&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[MQ · enlace privado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n21" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e42" value="Envia el pago interbancario&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[ISO 20022 · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n21" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e43" value="Publica el evento&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Kafka · mTLS · SASL]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t44" value="Una clave de idempotencia repetida NO vuelve a ejecutar la orden: devuelve la respuesta que se dio la primera vez. Es lo que impide el doble cargo ante un reintento del cliente o de la red." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="135" as="geometry"/></mxCell>
<mxCell id="t45" value="El orden de los pasos no es arbitrario: validar, cribar y evaluar el riesgo ocurren SIEMPRE antes de reservar fondos. Cribar despues de mover el dinero invertiria la logica del cumplimiento y dejaria a la entidad habiendo ejecutado la operacion que debia impedir (ADR-35)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="t46" value="El estado y el evento se escriben en la MISMA transaccion. De ahi que exista un solo camino de salida hacia el bus: si el dato se confirmo, su evento existe; si no se confirmo, no hay evento huerfano (ADR-24)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="300" height="185" as="geometry"/></mxCell>
<mxCell id="t47" value="Todo tramo interno va cifrado y con autenticacion mutua de ambos extremos. La credencial no se reutiliza entre saltos: cada llamada obtiene una de audiencia especifica mediante intercambio de credencial (ADR-20), de modo que una credencial capturada en un tramo no sirve en otro." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1960" y="100" width="290" height="270" as="geometry"/></mxCell>
<mxCell id="t48" value="Componente del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="1049" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t49" value="Otro contenedor del sistema" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="1077" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t50" value="Almacen de datos" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="1105" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t51" value="Sistema fuera del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="1133" width="220" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>