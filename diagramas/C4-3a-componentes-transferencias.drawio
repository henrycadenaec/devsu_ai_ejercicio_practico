<mxCell id="n13" value="&lt;b&gt;Controlador REST&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Spring MVC]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Valida el contrato y extrae la clave de idempotencia.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Interceptor de Auditoria&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Interceptor]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Registra toda accion sin que el desarrollador intervenga.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="430" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Validador de Operacion&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Specification]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;IBAN, titularidad, limites y hora de corte.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="430" width="320" height="115" as="geometry"/></mxCell>
