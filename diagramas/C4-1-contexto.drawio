<mxCell id="n9" value="&lt;b&gt;Plataforma de Banca por Internet&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema en alcance]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Canal digital web y movil: consulta de movimientos, transferencias y pagos propios e interbancarios, notificacion de movimientos y registro de auditoria.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="620" width="560" height="215" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;Proveedor de Verificacion de Identidad&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Prueba de vida, verificacion documental y cotejo facial.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Plataforma de Onboarding Digital&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema del banco]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Vincula clientes nuevos. Capacidad compartida por todos los canales.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="500" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Producto de Identidad&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema del banco]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Autentica y emite credenciales. Se configura, no se desarrolla.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="710" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Core Bancario&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema del banco]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sistema de registro: clientes, productos, saldos, movimientos y contabilidad.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="940" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Sistema Complementario de Cliente&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema del banco]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Amplia la informacion del cliente cuando se requiere en detalle.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="1100" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Red de Pagos Interbancarios&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sistema nacional de pagos: liquida por ciclos hacia otras entidades.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="290" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Servicio Corporativo de Cribado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema del banco]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Contrasta contra listas restrictivas antes de mover fondos.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="460" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;Proveedor de Mensajeria Primario&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Sistema externo]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Avisos por mensaje corto y correo electronico.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1450" y="700" width="420" height="120" as="geometry"/></mxCell>
