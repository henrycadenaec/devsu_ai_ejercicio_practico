<mxCell id="n21" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="999" width="34" height="21" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="1029" width="34" height="21" as="geometry"/></mxCell>
<mxCell id="n23" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="1059" width="34" height="21" as="geometry"/></mxCell>
<mxCell id="e24" value="Consulta, transfiere y paga&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e25" value="Atiende incidencias y consulta evidencia&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="Se vincula con reconocimiento facial&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="Verifica identidad del solicitante&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · REST]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e28" value="Provisiona la identidad verificada&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[SCIM 2.0]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e29" value="Delega autenticacion y obtiene credenciales&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[OpenID Connect]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e30" value="Consulta clientes y productos; ordena movimientos&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[MQ · SOAP sobre enlace privado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e31" value="Publica movimientos para proyeccion y aviso&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Captura de cambios]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e32" value="Solicita detalle del cliente bajo demanda&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · REST]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e33" value="Envia transferencias a otras entidades&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[ISO 20022 · red del banco central]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e34" value="Criba beneficiario antes de reservar fondos&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · REST]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e35" value="Envia avisos de movimiento&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS firmado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e36" value="Conmuta si el primario no responde&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS firmado]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e37" value="Entrega el aviso al dispositivo&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t38" value="El onboarding es una capacidad corporativa, reutilizable por oficina y por web, y por eso queda fuera de la frontera del sistema. Lo que aqui se disena es su integracion: al verificar la identidad, provisiona la credencial en el producto de identidad." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="t39" value="La norma obliga a notificar TODOS los movimientos, no solo los originados en el canal. Por eso el disparador es el propio Core y no la aplicacion, y se exigen dos proveedores con rutas independientes entre si." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1420" y="90" width="480" height="140" as="geometry"/></mxCell>
<mxCell id="t40" value="Persona que interactua con el sistema" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="764" y="966" width="480" height="21" as="geometry"/></mxCell>
<mxCell id="t41" value="Sistema en alcance de este diseno" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="764" y="996" width="480" height="21" as="geometry"/></mxCell>
<mxCell id="t42" value="Sistema del banco, fuera del alcance de construccion" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="764" y="1026" width="480" height="21" as="geometry"/></mxCell>
<mxCell id="t43" value="Sistema de un tercero" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="764" y="1056" width="480" height="21" as="geometry"/></mxCell>
<mxCell id="t44" value="Linea discontinua: flujo asincrono dirigido por eventos." style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="720" y="1085" width="520" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>