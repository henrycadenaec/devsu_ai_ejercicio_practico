<mxCell id="n7" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Persona natural]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Consulta movimientos, transfiere y paga. Se vincula desde el movil.&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="230" height="145" as="geometry"/></mxCell>
