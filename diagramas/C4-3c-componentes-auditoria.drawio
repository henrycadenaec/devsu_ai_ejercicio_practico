<mxCell id="n11" value="&lt;b&gt;Encadenador de Resumenes&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Hash Chain]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cada lote incorpora el resumen del lote anterior.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="430" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Escritor por Niveles&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Tiering]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Escribe en acceso inmediato y en archivo probatorio.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1460" y="430" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;API de Consulta y Reconstruccion&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: CQRS de lectura]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Reconstruye la actividad de un cliente en una fecha, incluido lo que se le mostro.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="610" width="800" height="115" as="geometry"/></mxCell>
