<mxCell id="e28" value="Lee el periodo reciente&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t29" value="La captura es ASINCRONA: la auditoria no anade latencia a la operacion ni puede hacerla fallar. La garantia de que nada se pierde no viene de escribir en linea, sino de la bandeja de salida del servicio de origen (ADR-31)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="t30" value="Bitemporalidad: registrar CUANDO OCURRIO el hecho y CUANDO SE SUPO permite responder a la pregunta que hace un auditor, que no es cual es el saldo de hoy, sino que le mostro el sistema al cliente el dia 14 a las 10:32. Sin las dos fechas, un dato corregido despues borra la version que el cliente vio." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="300" height="265" as="geometry"/></mxCell>
<mxCell id="t31" value="El modo de cumplimiento del bloqueo de objetos impide borrar el registro incluso a un administrador de la cuenta. El encadenamiento de resumenes permite DEMOSTRAR ante un tercero que no hubo alteracion, no solo afirmarlo." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1960" y="100" width="290" height="270" as="geometry"/></mxCell>
<mxCell id="t32" value="Componente del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="809" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t33" value="Otro contenedor del sistema" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="837" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t34" value="Almacen de datos" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="865" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t35" value="Sistema fuera del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="893" width="220" height="20" as="geometry"/></mxCell>
