<mxfile host="app.diagrams.net"><diagram name="Patrones de Diseno · caches, clientes frecuentes y niveles de auditoria">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1380" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b2" value="La frase &quot;mecanismo de persistencia de informacion para clientes frecuentes&quot; admite tres lecturas — se cubren las tres" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#B45309;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="2280" height="210" as="geometry"/></mxCell>
<mxCell id="b3" value="Capa 1 · Cache de datos de cliente — atiende la lectura (a)" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#1168BD;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="2280" height="190" as="geometry"/></mxCell>
<mxCell id="b4" value="Capa 2 · Preferencias y beneficiarios — atiende la lectura (c)" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#065F46;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="2280" height="190" as="geometry"/></mxCell>
<mxCell id="b5" value="Capa 3 · Invalidacion, precalentamiento y niveles — atiende la lectura (b)" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#0E7490;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="2280" height="190" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;Lectura (a) · rendimiento&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Guardar los datos de quienes mas usan el canal para responder rapido y no castigar al Core&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="155" width="650" height="140" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;Lectura (b) · niveles de auditoria&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Separar el periodo reciente consultable del archivo historico de los clientes con mas actividad&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="880" y="155" width="650" height="140" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Lectura (c) · beneficiarios frecuentes&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Conservar los destinatarios habituales de transferencias del propio cliente&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1670" y="155" width="650" height="140" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;Interceptor del BFF&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Interceptor]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Registra cada acceso sin que el desarrollador intervenga&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;Clasificador de frecuencia&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Strategy]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Frecuente = 8 o mas sesiones en 30 dias&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="420" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Servicio de Cliente&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Cache-Aside]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Consulta la cache; si falla, consulta el origen y la puebla&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1230" y="420" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Cache distribuida&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[ElastiCache Redis]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Coherente entre instancias; sobrevive al reemplazo&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1800" y="420" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Aplicacion de canal&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Web y movil]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Muestra y edita los destinatarios habituales&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="630" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Servicio de Preferencias y Frecuentes&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Repository]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Unico conjunto del que el canal ES sistema de registro&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="630" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Base de preferencias&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Aurora PostgreSQL]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Beneficiarios, alias y canales de aviso&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1230" y="630" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Dato autoritativo del canal&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[No vulnera RES-01]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Estos datos NO existen en el Core: no se duplican, se originan aqui&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1800" y="630" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;Bus de eventos&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Amazon MSK]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Publica todo cambio de cliente y de movimiento&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="840" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;Consumidor de invalidacion&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Publisher-Subscriber]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Retira de la cache de la Capa 1 la entrada afectada por el cambio&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="840" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;Precalentamiento selectivo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Cache warming]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Precarga en la Capa 1 la primera pantalla del cliente frecuente&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1230" y="840" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;Niveles de la auditoria&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Hot / Cold Tiering]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;24 meses en acceso inmediato, 7 anos en archivo probatorio&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1800" y="840" width="440" height="132" as="geometry"/></mxCell>
<mxCell id="e21" value="Alimenta" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="Marca al cliente" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="Lee y puebla" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="Consulta y edita" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e25" value="Persiste" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="Evento de cambio" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="Tras invalidar" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e28" value="Misma senal de frecuencia" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t29" value="LAS DOS FLECHAS QUE NO SE DIBUJAN: el consumidor de invalidacion y el precalentamiento actuan AMBOS sobre la cache distribuida de la Capa 1. No se trazan como linea porque tendrian que atravesar las cajas de la Capa 2, y una flecha que cruza cajas se lee peor que una frase. " style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1120" height="50" as="geometry"/></mxCell>
<mxCell id="t30" value="POR QUE INVALIDAR POR EVENTO Y NO SOLO POR CADUCIDAD: una caducidad corta reduce el riesgo de servir datos obsoletos a costa de la tasa de acierto; una larga mejora el acierto a costa de mostrar datos viejos. La invalidacion dirigida por el cambio elimina el dilema: permite caducidades amplias porque la entrada se retira en cuanto se conoce que el dato cambio (ADR-29)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="1120" height="50" as="geometry"/></mxCell>
<mxCell id="t31" value="LA DISTINCION QUE RESUELVE LA AMBIGUEDAD: la capa 1 guarda COPIAS SIN AUTORIDAD, desechables y reconstruibles; la capa 2 guarda DATO PROPIO DEL CANAL, del que no existe original en el Core. Confundirlas es el error conceptual que subyace a la frase del enunciado: trataria como desechable un dato que no lo es, o duplicaria en el canal informacion cuyo sistema de registro es el Core (RES-01)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1220" y="1090" width="1120" height="64" as="geometry"/></mxCell>
<mxCell id="t32" value="LO QUE NUNCA SE CACHEA: el saldo disponible en el instante de autorizar una transferencia y la decision de riesgo. Ambos se consultan siempre en su origen, porque servir un valor de hace treinta segundos podria admitir una operacion sin fondos o aplicar una politica ya revocada. La cache acelera la CONSULTA, nunca la DECISION. Trazabilidad: H-05 · RF-10 · ADR-29 · ADR-28 · ADR-32 · criterios 4 y 7 de evaluacion." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1230" width="2280" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>