<mxCell id="m31" value="Redirige con reto de codigo (code_challenge)&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[OIDC · PKCE · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="494" as="sourcePoint"/><mxPoint x="1308" y="494" as="targetPoint"/></mxGeometry></mxCell>
