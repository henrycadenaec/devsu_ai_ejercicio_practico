<mxCell id="m37" value="Guarda la credencial del lado del servidor&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="930" as="sourcePoint"/><mxPoint x="1018" y="930" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m38" value="Cookie de sesion: HttpOnly, SameSite y Secure" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="988" as="sourcePoint"/><mxPoint x="438" y="988" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m39" value="Ordena una transferencia de importe alto" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="1134" as="sourcePoint"/><mxPoint x="438" y="1134" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m40" value="Envia la orden y el testigo anti-CSRF&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="1218" as="sourcePoint"/><mxPoint x="728" y="1218" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m41" value="Consulta el nivel exigido para este importe&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[gRPC · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="1276" as="sourcePoint"/><mxPoint x="1598" y="1276" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m42" value="Exige nivel de autenticacion reforzado" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1598" y="1334" as="sourcePoint"/><mxPoint x="728" y="1334" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m43" value="Solicita confirmacion con segundo factor" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="1392" as="sourcePoint"/><mxPoint x="438" y="1392" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m44" value="Confirma con el segundo factor" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="1450" as="sourcePoint"/><mxPoint x="1308" y="1450" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m45" value="Credencial con nivel elevado&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[OIDC · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1308" y="1508" as="sourcePoint"/><mxPoint x="728" y="1508" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m46" value="Operacion admitida a tramite" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="1566" as="sourcePoint"/><mxPoint x="438" y="1566" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t47" value="RFC 7636 · PKCE hace inutil un codigo de autorizacion interceptado: sin el verificador original no puede canjearse. RFC 9700 desaconseja expresamente el flujo de credenciales directas, que enviaria la contrasena a traves del canal (ADR-14)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="498" width="284" height="102" as="geometry"/></mxCell>
<mxCell id="t48" value="ADR-10 · La credencial de acceso NUNCA llega al navegador. Lo unico que viaja es una cookie inaccesible desde guiones. Guardarla en el almacenamiento del navegador la dejaria al alcance de cualquier codigo inyectado en la pagina." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="992" width="284" height="102" as="geometry"/></mxCell>
<mxCell id="t49" value="ADR-19 · El nivel exigido lo decide la POLITICA DE RIESGO, no el codigo de cada pantalla. Asi puede demostrarse ante el supervisor que politica regia en cada momento, y cambiarla no obliga a desplegar los canales." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="1570" width="284" height="88" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>