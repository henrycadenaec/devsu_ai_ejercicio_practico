<mxfile host="app.diagrams.net"><diagram name="Zonas de Seguridad y Defensa en Profundidad">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="2160" pageHeight="1700" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b2" value="Zona publica · Internet" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#8A8A8A;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="1360" height="168" as="geometry"/></mxCell>
<mxCell id="b3" value="Zona de borde · primera barrera" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#B45309;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="346" width="1360" height="168" as="geometry"/></mxCell>
<mxCell id="b4" value="Zona de entrada · identidad y contrato" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#0E7490;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="572" width="1360" height="168" as="geometry"/></mxCell>
<mxCell id="b5" value="Zona de aplicacion · sin salida a Internet" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#1168BD;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="798" width="1360" height="224" as="geometry"/></mxCell>
<mxCell id="b6" value="Zona de datos · sin ruta a Internet" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#065F46;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="1080" width="1360" height="224" as="geometry"/></mxCell>
<mxCell id="b7" value="Zona de administracion · acceso excepcional" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#4C1D95;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="1362" width="1360" height="224" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Cliente legitimo&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Navegador o aplicacion movil&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="160" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;Trafico no deseado&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Automatizado, abusivo o dirigido&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="216" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;AWS WAF y Shield&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Reglas gestionadas, control de bots y limite de tasa por origen&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="386" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Amazon CloudFront&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Solo TLS 1.3; cabeceras de seguridad y transporte estricto&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="442" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Valida la firma de la credencial contra las claves publicadas&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="612" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Validacion de esquema&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Rechaza lo que no cumple el contrato antes de entrar&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="668" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Nodos de Amazon EKS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Subredes privadas; salida solo por puntos de enlace declarados&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="838" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Malla de servicios&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Autenticacion mutua obligatoria entre todos los servicios&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="894" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Politicas de red&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Denegacion por defecto; solo se permite lo declarado&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="950" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;Bases y almacenes&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cifrado en reposo con clave propia; sin direccion publica&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="1120" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;KMS y CloudHSM&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Material critico en modulo certificado; rotacion programada&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="1176" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;Datos sensibles&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Enmascarados en registros y en entornos que no son produccion&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="1232" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;Acceso justo a tiempo&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sin usuarios permanentes: se concede, se registra y caduca&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="1402" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;Sin acceso remoto directo&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sesiones mediadas y grabadas&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="1458" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;Cambios por tuberia&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;La consola no modifica produccion&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="96" y="1514" width="1308" height="46" as="geometry"/></mxCell>
<mxCell id="e23" value="Todo el trafico entra por un unico camino: no hay puertas alternativas" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="Lo que supera el borde llega todavia SIN identidad demostrada" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e25" value="Lo que pasa de aqui ya tiene identidad verificada y contrato valido" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="Ningun servicio alcanza los datos de otro servicio" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="La administracion no es un camino alternativo hacia los datos" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t28" value="PRINCIPIO RECTOR: ninguna capa se considera suficiente. El diseno asume que cualquiera de ellas puede ser superada y que la siguiente debe seguir siendo un obstaculo real. Es lo contrario del modelo de perimetro, donde atravesar el borde concede acceso a todo lo que hay detras." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1490" y="120" width="600" height="96" as="geometry"/></mxCell>
<mxCell id="t29" value="POR QUE SE CIFRA TAMBIEN DENTRO: si se admitiera trafico interno sin cifrar ni autenticar, un unico servicio comprometido -o un contenedor con una dependencia vulnerable- podria suplantar a cualquier otro. La autenticacion mutua convierte cada llamada en una identidad verificable, no en una direccion de red confiable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1490" y="250" width="600" height="110" as="geometry"/></mxCell>
<mxCell id="t30" value="POR QUE NO HAY SALIDA A INTERNET DESDE LA APLICACION: la extraccion de datos necesita un camino de salida. Si los nodos solo alcanzan puntos de enlace declarados, un compromiso no dispone de canal para sacar informacion, aunque consiga ejecutar codigo." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1490" y="394" width="600" height="96" as="geometry"/></mxCell>
<mxCell id="t31" value="POR QUE EL ACCESO ADMINISTRATIVO ES EXCEPCIONAL: en banca, el riesgo mas frecuente no es el intruso externo sino el acceso interno indebido o el error operativo. Un permiso permanente de administracion es un riesgo permanente; uno que se concede, se registra y caduca, no lo es." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1490" y="524" width="600" height="96" as="geometry"/></mxCell>
<mxCell id="t32" value="Trazabilidad: ADR-48 (segmentacion), ADR-49 (claves y secretos), ADR-20 (propagacion de identidad), ADR-50 (cumplimiento expresado como codigo) y criterio 13 de evaluacion." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1490" y="654" width="600" height="68" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>