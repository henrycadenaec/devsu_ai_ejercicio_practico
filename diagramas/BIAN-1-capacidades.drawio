<mxCell id="n18" value="&lt;b&gt;Fraud Evaluation&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[BIAN Service Domain]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Se realiza en: Politica de Riesgo&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1882" y="495" width="436" height="150" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;Regulatory Compliance&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Fuera de alcance]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Servicio Corporativo de Cribado: capacidad corporativa&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="765" width="545" height="165" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;Card Transaction&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Fuera de alcance]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;No hay tarjetas en el alcance del enunciado&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="765" width="545" height="165" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;Customer Offer&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Fuera de alcance]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sin venta de productos en el canal&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1215" y="765" width="545" height="165" as="geometry"/></mxCell>
<mxCell id="n22" value="&lt;b&gt;Collateral Administration&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Fuera de alcance]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sin credito en el alcance&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8A8A8A;strokeColor=#6B6B6B;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1780" y="765" width="545" height="165" as="geometry"/></mxCell>
<mxCell id="t23" value="QUE ES Y QUE NO ES ESTE MAPA: BIAN describe CAPACIDADES DE NEGOCIO, no una arquitectura tecnica. No dice que haya que crear un microservicio por dominio de servicio. Traducirlo literalmente produce decenas de servicios diminutos que solo se llaman entre si; su valor esta en dar un vocabulario comun y en revelar los huecos." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="1120" height="50" as="geometry"/></mxCell>
<mxCell id="t24" value="COMO SE HA USADO AQUI: primero se decidio la descomposicion por capacidad de negocio y perfil operativo (ADR-05, ADR-38), y despues se contrasto con el catalogo BIAN para comprobar que no faltaba ninguna capacidad relevante y para nombrar las fronteras con un vocabulario que cualquier banco reconoce." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1230" y="990" width="1110" height="50" as="geometry"/></mxCell>
<mxCell id="t25" value="LECTURA DE LA CORRESPONDENCIA: varios dominios de servicio se realizan FUERA del sistema que se disena -en el Core, en el producto de identidad o en la plataforma de onboarding-. Esto no es una carencia del diseno: es la consecuencia de respetar los sistemas de registro existentes en lugar de duplicar sus capacidades en el canal (ADR-23, ADR-15, ADR-17). Trazabilidad: H-15 · ADR-05 · criterio 3 de evaluacion." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1180" width="2280" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>