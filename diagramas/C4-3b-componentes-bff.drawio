<mxCell id="n7" value="&lt;b&gt;Sesion y cache&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[ElastiCache Redis]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sesion del navegador y respuestas cacheables&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="285" width="300" height="125" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Servicios de dominio&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Contenedores]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cliente, Movimientos, Transferencias…&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1960" y="470" width="290" height="125" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;Custodio de Credenciales&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Token Handler · RFC 8693]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;La credencial nunca llega al navegador; se intercambia por destino.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;Controlador de Sesion&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Spring Security]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Codigo de autorizacion con PKCE; recoge el retorno.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Filtro Anti-CSRF&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Doble testigo]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Exige testigo propio en toda operacion que modifica.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1460" y="290" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Cache de Respuesta&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Cache-Aside]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Solo datos no sensibles, con caducidad corta.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Compositor de Vistas&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: API Composition]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Agrega en paralelo varias llamadas en una respuesta.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Clientes de Dominio&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Resilience4j]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Tiempo limite, reintento, corte de circuito y compartimento.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1460" y="470" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Interceptor de Trazas y Actividad&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[OpenTelemetry]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Propaga el identificador de traza a todos los saltos y emite el registro de actividad.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="1260" height="105" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1976" y="675" width="34" height="26" as="geometry"/></mxCell>
