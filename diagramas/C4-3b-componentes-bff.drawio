<mxCell id="e20" value="Peticion del navegador&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e21" value="Enruta tras validar la credencial&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="Entrega la credencial en custodia" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="Codigo de autorizacion con PKCE&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[OIDC · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="Intercambia por credencial de destino&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[RFC 8693 · TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e25" value="Guarda la sesion&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="Emite y verifica el testigo" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="Peticion ya autenticada" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e28" value="Consulta antes de invocar" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e29" value="Lee y escribe&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e30" value="Invoca en paralelo" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e31" value="Consulta y ordena&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[REST · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e32" value="Instrumenta" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t33" value="Este contenedor es el UNICO que manipula la credencial de acceso. El navegador solo recibe una cookie inaccesible desde guiones y restringida al mismo sitio, de modo que un compromiso de la aplicacion web no expone la credencial (ADR-10). Es tambien la razon de que exista un backend por canal y no uno compartido." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="300" height="280" as="geometry"/></mxCell>
<mxCell id="t34" value="La composicion invoca a los servicios de dominio EN PARALELO y devuelve una respuesta por pantalla. Sin ella, una pantalla de inicio exigiria del orden de diez llamadas desde el navegador, con el coste de latencia que eso supone en red movil (ADR-09)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1960" y="100" width="290" height="275" as="geometry"/></mxCell>
<mxCell id="t35" value="Componente del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="674" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t36" value="Otro contenedor del sistema" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="702" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t37" value="Almacen de datos" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="730" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t38" value="Sistema fuera del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="758" width="220" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>