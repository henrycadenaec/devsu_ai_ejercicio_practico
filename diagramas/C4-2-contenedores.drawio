<mxCell id="t86" value="Sistema del banco" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2198" y="1504" width="285" height="20" as="geometry"/></mxCell>
