<mxCell id="e77" value="Registra el intento" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n29" target="n40"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e78" value="Persiste" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n31" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e79" value="Cachea" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n26" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t80" value="Los almacenes se agrupan por tipo: el nivel de contenedores no entra en ese detalle. Cada servicio tiene su propia instancia logica y no accede a la de otro (ADR-30). Se dibujan solo las relaciones de persistencia representativas." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2140" y="200" width="355" height="190" as="geometry"/></mxCell>
<mxCell id="t81" value="El bus se situa entre dominio e integracion porque es donde actua: recibe los cambios del Core y los eventos de los servicios, y alimenta notificacion, auditoria y proyeccion. Las lineas discontinuas son flujo asincrono." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2140" y="420" width="355" height="200" as="geometry"/></mxCell>
<mxCell id="t82" value="El proveedor de verificacion de identidad no aparece: se relaciona con el onboarding, no con ningun contenedor del sistema. Figura en el nivel de contexto." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2140" y="650" width="355" height="140" as="geometry"/></mxCell>
<mxCell id="t83" value="Persona" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2198" y="1411" width="285" height="20" as="geometry"/></mxCell>
<mxCell id="t84" value="Contenedor del sistema" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2198" y="1442" width="285" height="20" as="geometry"/></mxCell>
