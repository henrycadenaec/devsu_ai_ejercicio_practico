<mxCell id="n12" value="&lt;b&gt;S3 replicado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Misma retencion y mismo bloqueo]&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1325" y="590" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;DynamoDB&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Claves de idempotencia]&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="690" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;DynamoDB global&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Tabla multirregion]&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1325" y="690" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Infraestructura declarada como codigo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Un solo repositorio para ambas regiones]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="790" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Misma definicion aplicada&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Desplegada en cada cambio]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;La region secundaria no se improvisa el dia del fallo&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1325" y="790" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;Copias con bloqueo de borrado&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Retencion independiente de la cuenta]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="890" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;Copia de las copias&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Cuenta separada, solo lectura]&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1325" y="890" width="930" height="88" as="geometry"/></mxCell>
<mxCell id="e19" value="Replicacion continua&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Retraso tipico &lt; 1 s]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e20" value="Temas espejo&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Mismo orden por clave]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e21" value="Replicacion entre regiones&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Minutos]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="Tabla global&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Segundos]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="Mismo codigo aplicado" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="Copia en cuenta aislada" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e25" value="Trafico normal" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="Conmuta al fallar" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t27" value="PILOTO ENCENDIDO Y NO COPIA FRIA: la region secundaria ejecuta permanentemente el plano de control y una instancia minima de cada servicio. Es lo que permite comprometer una recuperacion en menos de una hora: no hay que construir nada, solo escalar lo que ya esta funcionando (ADR-42)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1040" width="1110" height="104" as="geometry"/></mxCell>
<mxCell id="t28" value="POR QUE NO ACTIVO-ACTIVO: dos regiones aceptando escrituras exigirian resolver conflictos sobre saldos, que es justamente el dato que no admite ambiguedad. El sobrecoste permanente tampoco se justifica frente a un objetivo de una hora. Se descarta de forma consciente, no por omision." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1210" y="1040" width="1110" height="104" as="geometry"/></mxCell>
<mxCell id="t29" value="LA PRUEBA FORMA PARTE DEL DISENO: la conmutacion se ensaya con periodicidad establecida y su resultado se registra. Un plan de recuperacion que nunca se ha ejecutado es una hipotesis, no un control: el supervisor pide evidencia del ensayo, no del documento." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="1170" width="1110" height="104" as="geometry"/></mxCell>
<mxCell id="t30" value="QUE SE PIERDE EN EL PEOR CASO: hasta cinco minutos de escrituras confirmadas. Las operaciones monetarias en vuelo quedan en un estado consultable gracias a la saga y a la clave de idempotencia; ninguna queda en un limbo sin registro (ADR-33, ADR-34)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1210" y="1170" width="1110" height="104" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>