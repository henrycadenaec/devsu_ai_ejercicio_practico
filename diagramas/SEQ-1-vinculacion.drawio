<mxCell id="m27" value="Solicita una sesion de vinculacion&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="378" as="sourcePoint"/><mxPoint x="728" y="378" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m28" value="Crea la sesion de verificacion&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[REST · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="436" as="sourcePoint"/><mxPoint x="1018" y="436" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m29" value="Testigo de sesion de un solo uso" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1018" y="494" as="sourcePoint"/><mxPoint x="728" y="494" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m30" value="Testigo de sesion" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="552" as="sourcePoint"/><mxPoint x="438" y="552" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m31" value="Presenta el documento y su rostro" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="148" y="698" as="sourcePoint"/><mxPoint x="438" y="698" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m32" value="Envia la captura directamente al proveedor&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · TLS 1.3 · SDK certificado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="756" as="sourcePoint"/><mxPoint x="1018" y="756" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m33" value="Prueba de vida y cotejo documento-rostro&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[ISO/IEC 30107-3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1018" y="814" as="sourcePoint"/><mxPoint x="1074" y="814" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m34" value="Veredicto y nivel de aseguramiento alcanzado&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Aviso firmado · HTTPS]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1018" y="898" as="sourcePoint"/><mxPoint x="728" y="898" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m35" value="Comprueba o crea al cliente&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[MQ · enlace privado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="1070" as="sourcePoint"/><mxPoint x="1598" y="1070" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m36" value="Identificador de cliente" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1598" y="1128" as="sourcePoint"/><mxPoint x="728" y="1128" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m37" value="Provisiona la identidad con su nivel IAL&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[SCIM 2.0 · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="1186" as="sourcePoint"/><mxPoint x="1308" y="1186" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m38" value="Identidad creada" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1308" y="1244" as="sourcePoint"/><mxPoint x="728" y="1244" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m39" value="Vinculacion completada" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="728" y="1302" as="sourcePoint"/><mxPoint x="438" y="1302" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m40" value="Registra el factor del dispositivo&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[OIDC · PKCE · TLS 1.3]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="1448" as="sourcePoint"/><mxPoint x="1308" y="1448" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m41" value="Identidad lista para autenticar" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1308" y="1506" as="sourcePoint"/><mxPoint x="438" y="1506" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m42" value="Acceso disponible" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="438" y="1564" as="sourcePoint"/><mxPoint x="148" y="1564" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t43" value="El testigo es de un solo uso y caducidad corta. La aplicacion nunca recibe credenciales del proveedor: recibe permiso para una sesion concreta." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="556" width="284" height="74" as="geometry"/></mxCell>
<mxCell id="t44" value="H-26 · La imagen biometrica NO pasa por el canal ni se almacena en el banco. El banco recibe el VEREDICTO y el nivel de aseguramiento alcanzado, no el dato biometrico. Es lo que reduce el alcance de proteccion de datos y evita custodiar un dato irrevocable (ADR-18, LOPDP)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="760" width="284" height="102" as="geometry"/></mxCell>
<mxCell id="t45" value="El aviso entrante se trata como entrada NO confiable: se verifica la firma del cuerpo, la marca temporal y el identificador de evento antes de procesarlo (ADR-22)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="902" width="284" height="74" as="geometry"/></mxCell>
<mxCell id="t46" value="NIST SP 800-63 · El nivel IAL alcanzado en este momento condiciona despues el nivel AAL exigible en cada operacion. Vincular la identidad con una verificacion debil y despues exigir autenticacion fuerte no corrige el origen." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="1306" width="284" height="88" as="geometry"/></mxCell>
<mxCell id="t47" value="A partir de aqui el canal solo USA la identidad; establecerla fue responsabilidad del onboarding. Separar ambas cosas permite cambiar de proveedor de verificacion sin tocar el canal, y que oficina y web reutilicen el mismo proceso (H-20)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1746" y="1568" width="284" height="102" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>