<mxCell id="e30" value="Envia el aviso&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS firmado · TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e31" value="Conmuta si el primario falla&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS firmado · TLS]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e32" value="Notifica al dispositivo&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[HTTPS · TLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e33" value="Informa del resultado" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n18" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e34" value="Registra cada intento" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e35" value="Persiste la evidencia&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[AWS SDK · TLS · KMS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e36" value="Agotados los intentos de 24 h" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t37" value="El disparador es el movimiento registrado en el Core, no la accion en la aplicacion. Solo asi se cubren los movimientos de cajero, comercio y abonos entrantes, que son la mayoria (H-06)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="300" height="175" as="geometry"/></mxCell>
<mxCell id="t38" value="La evidencia se conserva 7 anos y el contenido del mensaje 12 meses: se satisface la carga probatoria sin retener datos personales mas tiempo del necesario (ADR-37)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="300" height="175" as="geometry"/></mxCell>
<mxCell id="t39" value="Dos proveedores no aportan redundancia si comparten infraestructura, porque fallarian a la vez. Lo que se exige por contrato es DIVERSIDAD DE RUTA —operador y centro de datos distintos—, no simple pluralidad de contratos (ADR-36)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1960" y="100" width="290" height="270" as="geometry"/></mxCell>
<mxCell id="t40" value="Componente del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="849" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t41" value="Otro contenedor del sistema" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="877" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t42" value="Almacen de datos" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="905" width="220" height="20" as="geometry"/></mxCell>
<mxCell id="t43" value="Sistema fuera del contenedor" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="2018" y="933" width="220" height="20" as="geometry"/></mxCell>
