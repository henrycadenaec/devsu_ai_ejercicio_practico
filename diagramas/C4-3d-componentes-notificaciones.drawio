<mxCell id="n18" value="&lt;b&gt;Adaptadores de Envio&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Adapter]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Uno por proveedor, tras una interfaz comun.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1460" y="610" width="320" height="115" as="geometry"/></mxCell>
