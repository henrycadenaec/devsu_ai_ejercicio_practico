<mxCell id="n14" value="&lt;b&gt;Despachador&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Content-Based Router]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Encamina a la cola propia de cada proveedor.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="430" width="320" height="115" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Colas por Proveedor&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Patron: Bulkhead]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Un proveedor lento no frena la entrega de los demas.&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1460" y="430" width="320" height="115" as="geometry"/></mxCell>
