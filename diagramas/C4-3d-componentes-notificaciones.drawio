<mxCell id="e25" value="Consulta las preferencias&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[REST · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
