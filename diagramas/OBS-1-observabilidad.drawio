<mxCell id="n14" value="&lt;b&gt;Eventos de negocio&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Amazon MSK]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Transferencias por minuto, avisos entregados, altas&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1145" y="590" width="510" height="125" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Paneles por recorrido&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Uno por flujo de negocio, no por servidor&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1785" y="155" width="450" height="100" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Objetivos de servicio&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Disponibilidad y latencia con margen de error&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1785" y="271" width="450" height="100" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;Alerta por sintoma&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Se alerta de lo que el cliente sufre&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1785" y="387" width="450" height="100" as="geometry"/></mxCell>
