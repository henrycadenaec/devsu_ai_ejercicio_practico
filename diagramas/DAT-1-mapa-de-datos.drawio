<mxCell id="b4" value="Datos de los que el canal SI es sistema de registro" style="rounded=1;html=1;dashed=1;fillColor=none;strokeColor=#1168BD;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1500" height="420" as="geometry"/></mxCell>
