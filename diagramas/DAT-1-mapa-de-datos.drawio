<mxCell id="n6" value="&lt;b&gt;Clientes y productos&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Alta, baja y modificacion&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="155" width="348" height="100" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;Saldos&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Unico valor con validez contable&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="453" y="155" width="348" height="100" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Movimientos&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Asiento y su fecha valor&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="821" y="155" width="348" height="100" as="geometry"/></mxCell>
<mxCell id="n9" value="&lt;b&gt;Contabilidad&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cierre y cuadre diario&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#4F6B7A;strokeColor=#37505C;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1189" y="155" width="348" height="100" as="geometry"/></mxCell>
<mxCell id="n10" value="&lt;b&gt;Proyeccion de movimientos&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Aurora PostgreSQL]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Reconstruible desde el Core en cualquier momento&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="450" width="470" height="115" as="geometry"/></mxCell>
<mxCell id="n11" value="&lt;b&gt;Cache de consulta&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[ElastiCache Redis]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Caducidad corta; se puede vaciar sin perdida&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="450" width="470" height="115" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;b&gt;Datos en el dispositivo&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Almacen cifrado]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Solo lo que la pantalla necesita mostrar&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1065" y="450" width="470" height="115" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;b&gt;Preferencias de aviso y contactos frecuentes&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Aurora PostgreSQL]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Dato personal · mientras el cliente este vinculado&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="745" width="470" height="155" as="geometry"/></mxCell>
<mxCell id="n14" value="&lt;b&gt;Registro de auditoria de la actividad&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[OpenSearch + S3 con Object Lock]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Bitemporal e inmutable · 7 anos&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="745" width="470" height="155" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Evidencia de entrega de avisos&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[S3 con Object Lock]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Carga probatoria · 7 anos (contenido del mensaje, 12 meses)&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1065" y="745" width="470" height="155" as="geometry"/></mxCell>
<mxCell id="n16" value="&lt;b&gt;Claves de idempotencia&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[DynamoDB]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Tecnico · caduca a las 24 horas&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="85" y="920" width="470" height="155" as="geometry"/></mxCell>
<mxCell id="n17" value="&lt;b&gt;Estado de las operaciones y bandeja de salida&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Aurora PostgreSQL]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Operativo · 24 meses en linea, despues al archivo&lt;/font&gt;" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#FFFFFF;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="575" y="920" width="470" height="155" as="geometry"/></mxCell>
<mxCell id="n18" value="&lt;b&gt;Critico&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Credenciales y material de claves]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Modulo certificado; nunca en registros&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1645" y="155" width="590" height="118" as="geometry"/></mxCell>
<mxCell id="n19" value="&lt;b&gt;Restringido&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Identificadores de cuenta, importes y biometria]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cifrado con clave propia; enmascarado en registros&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1645" y="287" width="590" height="118" as="geometry"/></mxCell>
<mxCell id="n20" value="&lt;b&gt;Interno&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Trazas y metricas tecnicas]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cifrado; sin identificadores directos&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1645" y="419" width="590" height="118" as="geometry"/></mxCell>
<mxCell id="n21" value="&lt;b&gt;Publico&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Catalogos y textos de la interfaz]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Sin restriccion&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1645" y="551" width="590" height="118" as="geometry"/></mxCell>
<mxCell id="t22" value="El canal NO es sistema de registro de ninguno de estos datos. Puede leerlos y puede ordenar operaciones sobre ellos, pero la version valida es siempre la del Core. Cualquier discrepancia se resuelve a favor del Core, nunca al reves (ADR-23)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="85" y="270" width="1450" height="36" as="geometry"/></mxCell>
<mxCell id="t23" value="H-18 · Se declara EXPRESAMENTE que estas replicas no son autoritativas y que pueden ir por detras del Core unos segundos. Presentar una proyeccion como si fuera el saldo contable es el error que convierte una optimizacion de rendimiento en un problema regulatorio: ante una discrepancia, la entidad no podria sostener que el dato mostrado era el valido (ADR-28)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="85" y="580" width="1450" height="50" as="geometry"/></mxCell>
<mxCell id="t24" value="PRINCIPIO DE MINIMIZACION: cada conjunto de datos tiene un responsable, una clasificacion y un plazo. Lo que no tiene plazo definido acaba conservandose para siempre, y conservar datos personales sin justificacion es por si mismo un incumplimiento de la ley de proteccion de datos, no solo un coste (ADR-32)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1620" y="700" width="640" height="64" as="geometry"/></mxCell>
<mxCell id="t25" value="POR QUE EL CANAL SI ES REGISTRO DE ESTOS: las preferencias de aviso, la evidencia de entrega y el registro de actividad NO existen en el Core. Si el canal no los custodiase, la entidad no podria acreditar que aviso, ni que se le mostro al cliente. Por eso su retencion se trata con el mismo rigor que la contable." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1620" y="840" width="640" height="64" as="geometry"/></mxCell>
<mxCell id="t26" value="Trazabilidad: ADR-28 (consulta y comando), ADR-30 (persistencia por servicio), ADR-31 (auditoria), ADR-32 (ciclo de vida), ADR-37 (evidencia) · RF-08 · ASR-11." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1620" y="1000" width="640" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>