<mxCell id="m35" value="Envia la orden de pago&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[ISO 20022 · mTLS]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="982" as="sourcePoint"/><mxPoint x="1535" y="982" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m36" value="Admitida para el ciclo de liquidacion" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="1040" as="sourcePoint"/><mxPoint x="423" y="1040" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m37" value="En proceso, con referencia de seguimiento" style="html=1;rounded=0;dashed=1;endArrow=open;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="1098" as="sourcePoint"/><mxPoint x="145" y="1098" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m38" value="Liquidacion confirmada&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Aviso firmado · HTTPS]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="1244" as="sourcePoint"/><mxPoint x="423" y="1244" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m39" value="Confirma la reserva: el cargo se hace firme&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[MQ · enlace privado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="1302" as="sourcePoint"/><mxPoint x="1257" y="1302" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m40" value="Publica transferencia liquidada&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Kafka · mTLS · SASL]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="1360" as="sourcePoint"/><mxPoint x="1813" y="1360" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m41" value="Rechazada por la entidad destino&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Aviso firmado · HTTPS]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1535" y="1452" as="sourcePoint"/><mxPoint x="423" y="1452" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m42" value="COMPENSA: libera la reserva&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[MQ · enlace privado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="1510" as="sourcePoint"/><mxPoint x="1257" y="1510" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m43" value="Publica transferencia rechazada&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Kafka · mTLS · SASL]&lt;/font&gt;" style="html=1;rounded=0;dashed=1;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="1568" as="sourcePoint"/><mxPoint x="1813" y="1568" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="t44" value="ADR-34 · Si el cliente reintenta por perdida de red, la misma clave devuelve la respuesta original. Es lo que impide el doble cargo, y es un FILTRO previo: ningun desarrollador puede olvidarlo al anadir una operacion." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1958" y="408" width="284" height="88" as="geometry"/></mxCell>
<mxCell id="t45" value="H-27 · El orden importa. Cribar DESPUES de mover el dinero invertiria la logica del cumplimiento: dejaria a la entidad habiendo ejecutado la operacion que debia impedir (ADR-35)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1958" y="640" width="284" height="74" as="geometry"/></mxCell>
<mxCell id="t46" value="El cliente recibe EN PROCESO, no un exito que todavia no existe. La liquidacion interbancaria ocurre por ciclos y puede tardar; prometer lo contrario obligaria despues a desdecirse." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1958" y="1102" width="284" height="74" as="geometry"/></mxCell>
<mxCell id="t47" value="ADR-33 · La compensacion no es un bloque de recuperacion ante error: es un PASO DE NEGOCIO previsto, con su propio registro y su propio evento. Un fallo aqui deja la operacion en un estado consultable, nunca en un limbo." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1958" y="1572" width="284" height="88" as="geometry"/></mxCell>
<mxCell id="t48" value="Ningun paso mantiene una transaccion abierta sobre la red de pagos. Intentarlo acoplaria la disponibilidad del canal a la de una infraestructura externa que opera por ciclos (H-07)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1958" y="1572" width="284" height="88" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>