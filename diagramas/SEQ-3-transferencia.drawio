<mxCell id="m32" value="Persiste estado RESERVANDO y su evento en la misma transaccion&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[Aurora PostgreSQL]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#3F4A57;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423" y="782" as="sourcePoint"/><mxPoint x="479" y="782" as="targetPoint"/></mxGeometry></mxCell>
