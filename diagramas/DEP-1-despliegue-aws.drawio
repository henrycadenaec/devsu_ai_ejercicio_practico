<mxCell id="e60" value="Integracion con el Core&lt;br/&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;[MQ y SOAP sobre enlace privado]&lt;/font&gt;" style="html=1;rounded=0;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n34" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="t61" value="DynamoDB, S3 y OpenSearch son servicios gestionados con replicacion interna entre zonas: se consume un unico punto de acceso regional, de modo que dibujar una instancia dentro de cada zona seria un error de representacion. Aurora replica de forma sincrona entre las tres zonas y MSK mantiene copia de cada particion en las tres, por lo que tampoco se dibuja esa replicacion como flecha." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="115" y="1090" width="1450" height="76" as="geometry"/></mxCell>
<mxCell id="t62" value="Residencia de datos: no existe region del proveedor en el pais. Se elige la mas proxima de America del Sur y se compensa la latencia con el borde global, que termina la conexion segura a pocos milisegundos del cliente (ADR-03)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1430" y="95" width="300" height="175" as="geometry"/></mxCell>
<mxCell id="t63" value="Servicio de computo o de red" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="120" y="1259" width="228" height="22" as="geometry"/></mxCell>
<mxCell id="t64" value="Servicio de datos gestionado" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="120" y="1287" width="228" height="22" as="geometry"/></mxCell>
<mxCell id="t65" value="Sistema del banco, fuera de la nube" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="120" y="1315" width="228" height="22" as="geometry"/></mxCell>
<mxCell id="t66" value="TRES ZONAS Y NO DOS: con dos zonas, perder una deja la mitad de la capacidad y obliga a sobredimensionar al 100 % para sostener el pico. Con tres, perder una deja dos terceras partes y basta sobredimensionar al 50 %. Ademas, los sistemas que deciden por quorum -el bus de eventos entre ellos- necesitan un numero impar de miembros para no empatar (ADR-40)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="400" y="1230" width="1220" height="110" as="geometry"/></mxCell>
<mxCell id="t67" value="La replicacion entre regiones se detalla en el diagrama de recuperacion ante desastres, para no mezclar el estado estable con el de contingencia." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#D9B94C;align=left;verticalAlign=top;fontSize=11;size=14;" vertex="1" parent="1"><mxGeometry x="1700" y="1330" width="700" height="62" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>